# Roy Runner scoreboard (Google sign-in + leaderboard). Both optional: leave them unset and
# the game keeps a personal best on this device only. See docs/leaderboard/SETUP.md.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# The publishable / anon key. It is public by design (it ships in the bundle); RLS and the
# database functions in supabase/migrations are what protect the data.
VITE_SUPABASE_ANON_KEY=
