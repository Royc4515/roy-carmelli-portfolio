# Roy Runner scoreboard (Google sign-in + leaderboard). All optional: with none of them set
# the game keeps a personal best on this device only. See docs/leaderboard/SETUP.md.

# Google OAuth client ID. Public by design: the browser build and the /api functions share it.
VITE_GOOGLE_CLIENT_ID=<id>.apps.googleusercontent.com

# Server only. Signs the session cookie; at least 32 random characters
# (e.g. `openssl rand -base64 32`). Never prefix it with VITE_, that would ship it.
SESSION_SECRET=

# Server only. Set automatically when the Neon store is connected in Vercel.
DATABASE_URL=

# Pixel Roy chat (POST /api/chat). Optional: unset, the launcher is hidden and the API answers
# 503. Needs DATABASE_URL and SESSION_SECRET above too (daily limits). See docs/chat/SETUP.md.

# Server only. A Groq API key from a free account with NO billing added, so it can never cost
# money. Never prefix it with VITE_, that would ship it to every visitor.
GROQ_API_KEY=

# Public switch for the floating launcher. "true" shows it.
VITE_CHAT_ENABLED=

# Optional. Comma-separated Groq model IDs, tried in order. Default:
# openai/gpt-oss-120b,openai/gpt-oss-20b
CHAT_MODELS=

# Optional. CHAT_ENABLED=false turns the API off (Vercel applies env changes on the next deploy;
# revoking the key in the Groq console is instant). CHAT_GUARD=off skips the jailbreak check.
CHAT_ENABLED=
CHAT_GUARD=
